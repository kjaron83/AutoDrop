msgid "Access forbidden: Administrator privileges required."
msgstr "Hozzáférés megtagadva: Adminisztrátori jogosultság szükséges."

#: autodrop/core/validation.py:51 autodrop/core/validation.py:57
#: autodrop/core/validation.py:120 autodrop/core/validation.py:126
#, python-brace-format
msgid "'{field}' is required."
msgstr "'{field}' kitöltése kötelező."

#: autodrop/core/validation.py:69
#, python-brace-format
msgid "'{field}' must be a valid number."
msgstr "'{field}' érvényes szám kell legyen."

#: autodrop/core/validation.py:80
#, python-brace-format
msgid "'{field}' must be a valid whole number."
msgstr "'{field}' érvényes egész szám kell legyen."

#: autodrop/core/validation.py:86
#, python-brace-format
msgid "'{field}' must be at least {min_val}."
msgstr "'{field}' értéke legalább {min_val} kell legyen."

#: autodrop/core/validation.py:92
#, python-brace-format
msgid "'{field}' must be at most {max_val}."
msgstr "'{field}' értéke legfeljebb {max_val} lehet."

#: autodrop/core/validation.py:135
#, python-brace-format
msgid "'{field}' must be a valid date in YYYY-MM-DD format."
msgstr "'{field}' érvényes dátum kell legyen ÉÉÉÉ-HH-NN formátumban."

#: autodrop/core/validation.py:149
#, python-brace-format
msgid "'{field}' must be a valid time in HH:MM format."
msgstr "'{field}' érvényes időpont kell legyen ÓÓ:PP formátumban."

#: autodrop/core/validation.py:157
#, python-brace-format
msgid "'{field}' must be a valid date and time."
msgstr "'{field}' érvényes dátum és időpont kell legyen."

