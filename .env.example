# AutoDrop Environment Configuration

# Application & Security
APP_NAME=AutoDrop
APP_EMAIL=info@autodrop.local
ENVIRONMENT=development
APP_DOMAIN=http://localhost:8000
SECRET_KEY=change-this-to-a-secure-random-secret-key-min-32-chars

# Database Connection (SQLite for local development, MySQL/MariaDB for production)
DATABASE_URL=sqlite:///./autodrop.db

# Internationalization (i18n)
DEFAULT_LOCALE=hu
SUPPORTED_LOCALES=["hu", "en"]

# Authentication & Session Settings
SESSION_COOKIE_NAME=autodrop_session
SESSION_MAX_AGE_SECONDS=604800
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=2

# SMTP Email Delivery (Optional for local development; in dev, emails log to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@autodrop.local
SMTP_TLS=true

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE=
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
